# WhatsApp number in international format, digits only (no +, spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Public contact email, shown in the footer. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Lead capture (feature 006). Server-only; never commit real values. ---
# MongoDB Atlas connection string with the database name in the path (tareeq_dev locally, tareeq in production)
MONGODB_URI=
# Resend API key with sending access only (starts with re_)
RESEND_API_KEY=
# Email address that receives new lead notifications
LEAD_NOTIFICATION_TO=
# 32+ random characters for the rate-limit key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Optional sender, e.g. Tareeq <hello@your-verified-domain>. Leave empty to use Resend's onboarding sender (reaches the Resend account owner only)
LEAD_EMAIL_FROM=

# --- Admin panel (feature 022). Server-only; never commit real values. ---
# The one admin's sign-in email
ADMIN_EMAIL=
# bcrypt hash of the admin password. Make one with: npm run hash-password -- "your password"
# Next.js expands $ signs in .env files, even inside quotes, so write a backslash before every $ here:
#   ADMIN_PASSWORD_HASH=\$2b\$12\$...   (npm run hash-password prints this ready to paste)
# In a host dashboard (Vercel and similar) paste the plain hash, with no backslashes.
ADMIN_PASSWORD_HASH=
# 32+ random characters that sign the session cookie: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
